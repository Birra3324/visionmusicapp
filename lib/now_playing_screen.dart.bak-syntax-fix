import 'dart:math' as math;
import 'dart:ui' as ui;

import 'package:flutter/material.dart';
import 'package:just_audio/just_audio.dart';
import 'package:visionmusicapp/audio_manager.dart';
import 'package:visionmusicapp/song.dart';
import 'package:visionmusicapp/vision_theme.dart';

class NowPlayingScreen extends StatefulWidget {
  final AudioManager audioManager;

  const NowPlayingScreen({super.key, required this.audioManager});

  @override
  State<NowPlayingScreen> createState() => _NowPlayingScreenState();
}

class _NowPlayingScreenState extends State<NowPlayingScreen>
    with TickerProviderStateMixin {
  late AnimationController _fadeController;
  late AnimationController _vinylController;
  late AnimationController _pulseController;

  @override
  void initState() {
    super.initState();
    _fadeController = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 700),
    )..forward();

    _vinylController = AnimationController(
      vsync: this,
      duration: const Duration(seconds: 4),
    );

    _pulseController = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 1800),
    );

    // Start spinning and pulsing if already playing
    if (widget.audioManager.isPlaying) {
      _vinylController.repeat();
      _pulseController.repeat(reverse: true);
    }

    widget.audioManager.isPlayingStream.listen((playing) {
      if (!mounted) return;
      if (playing) {
        _vinylController.repeat();
        _pulseController.repeat(reverse: true);
      } else {
        _vinylController.stop();
        _pulseController.stop();
      }
    });
  }

  @override
  void dispose() {
    _fadeController.dispose();
    _vinylController.dispose();
    _pulseController.dispose();
    super.dispose();
  }

  String _fmt(Duration d) {
    if (d.inMilliseconds <= 0) return '0:00';
    final m = d.inMinutes;
    final s = d.inSeconds % 60;
    return '$m:${s.toString().padLeft(2, '0')}';
  }

  void _showLyricsSheet(BuildContext context, Song song) {
    final lyrics = song.lyrics ?? 'No lyrics available for this track.';
    showModalBottomSheet(
      context: context,
      backgroundColor: kDarkCard,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(kRadiusXL)),
      ),
      isScrollControlled: true,
      builder: (context) => DraggableScrollableSheet(
        expand: false,
        minChildSize: 0.4,
        maxChildSize: 0.9,
        builder: (context, sc) => Padding(
          padding: const EdgeInsets.fromLTRB(24, 16, 24, 32),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Center(
                child: Container(
                  width: 40,
                  height: 4,
                  decoration: BoxDecoration(
                    color: Colors.white24,
                    borderRadius: BorderRadius.circular(999),
                  ),
                ),
              ),
              const SizedBox(height: 16),
              Text('Lyrics', style: kStyleHeadline),
              const SizedBox(height: 4),
              Text(song.title,
                  style: kStyleCaption,
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis),
              const SizedBox(height: 16),
              Expanded(
                child: SingleChildScrollView(
                  controller: sc,
                  child: Text(lyrics, style: kStyleBody.copyWith(height: 1.8)),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  void _showVolumeSheet(BuildContext context) {
    showModalBottomSheet(
      context: context,
      backgroundColor: kDarkCard,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(kRadiusXL)),
      ),
      builder: (context) {
        double vol = widget.audioManager.volume;
        return StatefulBuilder(
          builder: (context, setS) => Padding(
            padding: const EdgeInsets.fromLTRB(24, 16, 24, 32),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                Container(
                  width: 40,
                  height: 4,
                  decoration: BoxDecoration(
                    color: Colors.white24,
                    borderRadius: BorderRadius.circular(999),
                  ),
                ),
                const SizedBox(height: 20),
                Text('Volume', style: kStyleHeadline),
                const SizedBox(height: 16),
                Row(
                  children: [
                    const Icon(Icons.volume_mute_rounded, color: kTextSoft, size: 20),
                    Expanded(
                      child: Slider(
                        min: 0,
                        max: 1,
                        value: vol.clamp(0.0, 1.0),
                        activeColor: kVisionGold,
                        inactiveColor: Colors.white24,
                        onChanged: (v) {
                          setS(() => vol = v);
                          widget.audioManager.setVolume(v);
                        },
                      ),
                    ),
                    const Icon(Icons.volume_up_rounded, color: kTextSoft, size: 20),
                  ],
                ),
              ],
            ),
          ),
        );
      },
    );
  }

  @override
  Widget build(BuildContext context) {
    return StreamBuilder<Song?>(
      stream: widget.audioManager.currentSongStream,
      initialData: widget.audioManager.currentSong,
      builder: (context, snapshot) {
        final song = snapshot.data;

        if (song == null) {
          return const Scaffold(
            backgroundColor: kDarkBackground,
            body: Center(
              child: Text('No song playing', style: TextStyle(color: kTextSoft)),
            ),
          );
        }

        return Scaffold(
          backgroundColor: kDarkBackground,
          body: Stack(
            fit: StackFit.expand,
            children: [
              // ── Blurred cinematic background ─────────────────────────────
              if (song.imagePath != null)
                FadeTransition(
                  opacity: _fadeController,
                  child: ImageFiltered(
                    imageFilter: ui.ImageFilter.blur(sigmaX: 40, sigmaY: 40),
                    child: ColorFiltered(
                      colorFilter: ColorFilter.mode(
                        Colors.black.withValues(alpha: 0.65),
                        BlendMode.darken,
                      ),
                      child: Image.asset(
                        song.imagePath!,
                        fit: BoxFit.cover,
                        key: ValueKey(song.imagePath),
                      ),
                    ),
                  ),
                )
              else
                Container(
                  decoration: const BoxDecoration(
                    gradient: LinearGradient(
                      begin: Alignment.topLeft,
                      end: Alignment.bottomRight,
                      colors: [Color(0xFF1A0800), kDarkBackground],
                    ),
                  ),
                ),

              // ── Cinematic gradient overlay ────────────────────────────────
              Container(
                decoration: const BoxDecoration(
                  gradient: LinearGradient(
                    begin: Alignment.topCenter,
                    end: Alignment.bottomCenter,
                    stops: [0.0, 0.35, 0.7, 1.0],
                    colors: [
                      Color(0x99000000),
                      Colors.transparent,
                      Color(0x88000000),
                      Color(0xEE000000),
                    ],
                  ),
                ),
              ),

              // ── Content ──────────────────────────────────────────────────
              SafeArea(
                child: Column(
                  children: [
                    // ─ Header ─────────────────────────────────────────────
                    Padding(
                      padding: const EdgeInsets.fromLTRB(8, 8, 8, 0),
                      child: Row(
                        children: [
                          IconButton(
                            icon: const Icon(Icons.keyboard_arrow_down_rounded, size: 32),
                            color: kTextMain,
                            onPressed: () => Navigator.of(context).pop(),
                          ),
                          Expanded(
                            child: Column(
                              children: [
                                Text(
                                  'NOW PLAYING',
                                  style: kStyleLabel.copyWith(
                                    color: kVisionGold,
                                    letterSpacing: 2.5,
                                    fontWeight: FontWeight.w700,
                                  ),
                                ),
                                const SizedBox(height: 2),
                                Text(
                                  song.albumTitle ?? song.artist,
                                  style: kStyleCaption.copyWith(fontSize: 12),
                                  maxLines: 1,
                                  overflow: TextOverflow.ellipsis,
                                  textAlign: TextAlign.center,
                                ),
                              ],
                            ),
                          ),
                          IconButton(
                            icon: const Icon(Icons.more_vert_rounded, size: 24),
                            color: kTextMain,
                            onPressed: () => _showLyricsSheet(context, song),
                          ),
                        ],
                      ),
                    ),

                    const SizedBox(height: kSpaceS),

                    // ─ Vinyl Artwork ───────────────────────────────────────
                    Expanded(
                      flex: 5,
                      child: Padding(
                        padding: const EdgeInsets.symmetric(horizontal: 32),
                        child: Center(
                          child: _VinylArtwork(
                            song: song,
                            vinylController: _vinylController,
                            pulseController: _pulseController,
                          ),
                        ),
                      ),
                    ),

                    const SizedBox(height: kSpaceM),

                    // ─ Title / Artist / Heart ──────────────────────────────
                    Padding(
                      padding: const EdgeInsets.symmetric(horizontal: kSpaceL),
                      child: Row(
                        crossAxisAlignment: CrossAxisAlignment.center,
                        children: [
                          Expanded(
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Text(
                                  song.title,
                                  maxLines: 1,
                                  overflow: TextOverflow.ellipsis,
                                  style: const TextStyle(
                                    color: kTextMain,
                                    fontSize: 24,
                                    fontWeight: FontWeight.w800,
                                    letterSpacing: -0.4,
                                    height: 1.2,
                                  ),
                                ),
                                const SizedBox(height: 5),
                                Text(
                                  song.artist,
                                  maxLines: 1,
                                  overflow: TextOverflow.ellipsis,
                                  style: const TextStyle(
                                    color: kTextSoft,
                                    fontSize: 15,
                                    fontWeight: FontWeight.w400,
                                  ),
                                ),
                              ],
                            ),
                          ),
                          StreamBuilder<bool>(
                            stream: widget.audioManager.isPlayingStream
                                .map((_) => widget.audioManager.isFavorite(song))
                                .distinct(),
                            initialData: widget.audioManager.isFavorite(song),
                            builder: (context, snap) {
                              final fav = snap.data ?? false;
                              return IconButton(
                                icon: Icon(
                                  fav ? Icons.favorite_rounded : Icons.favorite_border_rounded,
                                  color: fav ? kVisionGoldLight : Colors.white54,
                                  size: 28,
                                ),
                                onPressed: () {
                                  widget.audioManager.toggleFavorite(song);
                                  setState(() {});
                                },
                              );
                            },
                          ),
                        ],
                      ),
                    ),

                    const SizedBox(height: kSpaceM),

                    // ─ Waveform seek bar ───────────────────────────────────
                    Padding(
                      padding: const EdgeInsets.symmetric(horizontal: kSpaceL),
                      child: Column(
                        children: [
                          StreamBuilder<Duration>(
                            stream: widget.audioManager.positionStream,
                            initialData: Duration.zero,
                            builder: (context, posSnap) =>
                                StreamBuilder<Duration?>(
                              stream: widget.audioManager.durationStream,
                              initialData: Duration.zero,
                              builder: (context, durSnap) =>
                                  StreamBuilder<bool>(
                                stream: widget.audioManager.isPlayingStream,
                                initialData: false,
                                builder: (context, playSnap) {
                                  final pos = posSnap.data ?? Duration.zero;
                                  final dur = durSnap.data ?? Duration.zero;
                                    return Slider(
                                      value: pos.inMilliseconds.toDouble(),
                                      max: (dur.inMilliseconds == 0) ? 1.0 : dur.inMilliseconds.toDouble(),
                                      onChanged: (value) {
                                        widget.audioManager.seek(Duration(milliseconds: value.toInt()));
                                      },
                                      activeColor: const Color(0xFFD4AF37),
                                      inactiveColor: Colors.grey[800],
                                    );
                                    },
                                  ),
                                ),
                              ),
                            ),
                          ),
                          const SizedBox(height: kSpaceXS),
                          StreamBuilder<Duration>(
                            stream: widget.audioManager.positionStream,
                            initialData: Duration.zero,
                            builder: (context, posSnap) =>
                                StreamBuilder<Duration?>(
                              stream: widget.audioManager.durationStream,
                              initialData: Duration.zero,
                              builder: (context, durSnap) => Row(
                                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                                children: [
                                  Text(_fmt(posSnap.data ?? Duration.zero), style: kStyleLabel),
                                  Text(_fmt(durSnap.data ?? Duration.zero), style: kStyleLabel),
                                ],
                              ),
                            ),
                          ),
                        ],
                      ),
                    ),

                    const SizedBox(height: kSpaceS),

                    // ─ Playback controls ───────────────────────────────────
                    Padding(
                      padding: const EdgeInsets.symmetric(horizontal: kSpaceM),
                      child: StreamBuilder<bool>(
                        stream: widget.audioManager.shuffleEnabledStream,
                        initialData: false,
                        builder: (context, shuffleSnap) =>
                            StreamBuilder<LoopMode>(
                          stream: widget.audioManager.loopModeStream,
                          initialData: LoopMode.off,
                          builder: (context, loopSnap) {
                            final shuffleOn = shuffleSnap.data ?? false;
                            final loopMode = loopSnap.data ?? LoopMode.off;

                            IconData repeatIcon;
                            Color repeatColor;
                            switch (loopMode) {
                              case LoopMode.one:
                                repeatIcon = Icons.repeat_one_rounded;
                                repeatColor = kVisionGoldLight;
                              case LoopMode.all:
                                repeatIcon = Icons.repeat_rounded;
                                repeatColor = kVisionGoldLight;
                              case LoopMode.off:
                                repeatIcon = Icons.repeat_rounded;
                                repeatColor = Colors.white38;
                            }

                            return Row(
                              mainAxisAlignment: MainAxisAlignment.spaceEvenly,
                              crossAxisAlignment: CrossAxisAlignment.center,
                              children: [
                                _ControlButton(
                                  icon: Icons.shuffle_rounded,
                                  color: shuffleOn ? kVisionGoldLight : Colors.white38,
                                  onTap: widget.audioManager.toggleShuffle,
                                ),
                                _ControlButton(
                                  icon: Icons.skip_previous_rounded,
                                  size: 38,
                                  color: Colors.white,
                                  onTap: widget.audioManager.skipToPrevious,
                                ),
                                // Play / Pause — glowing gold button
                                StreamBuilder<bool>(
                                  stream: widget.audioManager.isPlayingStream,
                                  initialData: widget.audioManager.isPlaying,
                                  builder: (context, playSnap) {
                                    final playing = playSnap.data ?? false;
                                    return GestureDetector(
                                      onTap: widget.audioManager.togglePlayPause,
                                      child: Container(
                                        width: 72,
                                        height: 72,
                                        decoration: BoxDecoration(
                                          shape: BoxShape.circle,
                                          gradient: const LinearGradient(
                                            begin: Alignment.topLeft,
                                            end: Alignment.bottomRight,
                                            colors: [kVisionGoldLight, kVisionGold, kVisionGoldDeep],
                                          ),
                                          boxShadow: [
                                            BoxShadow(
                                              color: kVisionGold.withValues(alpha: 0.55),
                                              blurRadius: 30,
                                              offset: const Offset(0, 8),
                                            ),
                                            BoxShadow(
                                              color: kVisionGold.withValues(alpha: 0.2),
                                              blurRadius: 60,
                                              offset: const Offset(0, 4),
                                            ),
                                          ],
                                        ),
                                        child: Icon(
                                          playing ? Icons.pause_rounded : Icons.play_arrow_rounded,
                                          color: Colors.black,
                                          size: 40,
                                        ),
                                      ),
                                    );
                                  },
                                ),
                                _ControlButton(
                                  icon: Icons.skip_next_rounded,
                                  size: 38,
                                  color: Colors.white,
                                  onTap: widget.audioManager.skipToNext,
                                ),
                                _ControlButton(
                                  icon: repeatIcon,
                                  color: repeatColor,
                                  onTap: widget.audioManager.cycleRepeatMode,
                                ),
                              ],
                            );
                          },
                        ),
                      ),
                    ),

                    const SizedBox(height: kSpaceS),

                    // ─ Secondary actions ───────────────────────────────────
                    Padding(
                      padding: const EdgeInsets.symmetric(horizontal: kSpaceXL),
                      child: Row(
                        mainAxisAlignment: MainAxisAlignment.spaceBetween,
                        children: [
                          _SecondaryButton(
                            icon: Icons.volume_down_rounded,
                            label: 'Volume',
                            onTap: () => _showVolumeSheet(context),
                          ),
                          _SecondaryButton(
                            icon: Icons.queue_music_rounded,
                            label: 'Lyrics',
                            onTap: () => _showLyricsSheet(context, song),
                          ),
                        ],
                      ),
                    ),

                    SizedBox(height: MediaQuery.of(context).padding.bottom + kSpaceS),
                  ],
                ),
              ),
            ],
          );
  }
}

// ─── Vinyl Artwork Widget ─────────────────────────────────────────────────────

class _VinylArtwork extends StatelessWidget {
  final Song song;
  final AnimationController vinylController;
  final AnimationController pulseController;

  const _VinylArtwork({
    required this.song,
    required this.vinylController,
    required this.pulseController,
  });

  @override
  Widget build(BuildContext context) {
    return AnimatedBuilder(
      animation: Listenable.merge([vinylController, pulseController]),
      builder: (context, child) {
        final pulse = pulseController.value;
        final glowRadius = 28.0 + pulse * 18.0;
        final glowOpacity = 0.28 + pulse * 0.22;
        final ringScale = 1.0 + pulse * 0.045;

        return Stack(
          alignment: Alignment.center,
          children: [
            // Outer glow ring
            Transform.scale(
              scale: ringScale,
              child: Container(
                width: double.infinity,
                height: double.infinity,
                decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  boxShadow: [
                    BoxShadow(
                      color: kVisionGold.withValues(alpha: glowOpacity),
                      blurRadius: glowRadius,
                      spreadRadius: 4,
                    ),
                  ],
                ),
              ),
            ),

            // Vinyl record (outer black disc)
            RotationTransition(
              turns: vinylController,
              child: Container(
                width: double.infinity,
                height: double.infinity,
                decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  color: const Color(0xFF0D0D0D),
                  border: Border.all(
                    color: Colors.white.withValues(alpha: 0.06),
                    width: 1.5,
                  ),
                  boxShadow: [
                    BoxShadow(
                      color: Colors.black.withValues(alpha: 0.7),
                      blurRadius: 24,
                      offset: const Offset(0, 10),
                    ),
                  ],
                ),
                child: CustomPaint(
                  painter: _VinylGroovesPainter(),
                  child: Center(
                    // Artwork circle in the middle
                    child: FractionallySizedBox(
                      widthFactor: 0.55,
                      heightFactor: 0.55,
                      child: Hero(
                        tag: 'artwork_${song.id}',
                        child: ClipOval(
                          child: Image.asset(
                            song.imagePath ?? 'assets/images/visionlogo.jpg',
                            fit: BoxFit.cover,
                            key: ValueKey(song.id),
                          ),
                        ),
                      ),
                    ),
                  ),
                ),
              ),
            ),

            // Center spindle dot
            Container(
              width: 10,
              height: 10,
              decoration: BoxDecoration(
                shape: BoxShape.circle,
                color: kVisionGoldLight,
                boxShadow: [
                  BoxShadow(
                    color: kVisionGold.withValues(alpha: 0.8),
                    blurRadius: 8,
                  ),
                ],
              ),
            ),
          ],
        );
      },
    );
  }
}

// ─── Vinyl Grooves Painter ────────────────────────────────────────────────────

class _VinylGroovesPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final center = Offset(size.width / 2, size.height / 2);
    final maxR = math.min(size.width, size.height) / 2;

    final paint = Paint()
      ..color = Colors.white.withValues(alpha: 0.04)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 0.8;

    // Draw concentric groove rings
    for (double r = maxR * 0.30; r < maxR * 0.95; r += maxR * 0.04) {
      canvas.drawCircle(center, r, paint);
    }

    // Gold sheen arc
    final sheenPaint = Paint()
      ..shader = SweepGradient(
        colors: [
          Colors.transparent,
          kVisionGold.withValues(alpha: 0.08),
          Colors.transparent,
        ],
        stops: const [0.0, 0.15, 0.35],
      ).createShader(Rect.fromCircle(center: center, radius: maxR))
      ..style = PaintingStyle.fill;
    canvas.drawCircle(center, maxR * 0.95, sheenPaint);
  }

  @override
  bool shouldRepaint(covariant CustomPainter old) => false;
}

// ─── Control button ───────────────────────────────────────────────────────────

class _ControlButton extends StatelessWidget {
  final IconData icon;
  final Color color;
  final double size;
  final VoidCallback onTap;

  const _ControlButton({
    required this.icon,
    required this.color,
    required this.onTap,
    this.size = 26,
  });

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTap: onTap,
      behavior: HitTestBehavior.opaque,
      child: Padding(
        padding: const EdgeInsets.all(8),
        child: Icon(icon, color: color, size: size),
      ),
    );
  }
}

class _SecondaryButton extends StatelessWidget {
  final IconData icon;
  final String label;
  final VoidCallback onTap;

  const _SecondaryButton({
    required this.icon,
    required this.label,
    required this.onTap,
  });

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTap: onTap,
      child: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          Icon(icon, color: kTextSoft, size: 22),
          const SizedBox(height: 4),
          Text(label, style: kStyleLabel.copyWith(fontSize: 10)),
        ],
      ),
    );
  }
}
